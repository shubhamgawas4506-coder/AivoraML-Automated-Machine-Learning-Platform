# Optional remote advisor. The core profiling, training, prediction, and export
# workflows run locally without this key.
MISTRAL_API_KEY=
MISTRAL_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AIVORAML_AI_PROVIDER=auto
AIVORAML_ENABLE_REMOTE_AI=false
AIVORAML_AUTO_PROFILE_AI=false

# Local workspace limits
AIVORAML_DATA_DIR=storage
AIVORAML_DISABLE_PERSISTENCE=false
AIVORAML_MAX_UPLOAD_MB=100
AIVORAML_MAX_ROWS=1000000
AIVORAML_MAX_COLUMNS=500
AIVORAML_MAX_CELLS=25000000
AIVORAML_MAX_BATCH_MB=25
AIVORAML_MAX_BATCH_ROWS=10000
AIVORAML_MAX_BATCH_CELLS=2000000
AIVORAML_MAX_PROJECTS=100
AIVORAML_MAX_PROJECT_SNAPSHOT_MB=512
AIVORAML_MODEL_VERSION_RETENTION=20
AIVORAML_TRAINING_WORKERS=1
AIVORAML_ML_JOBS=2

# Prediction values are not retained by default. Set true only when the local
# audit benefit outweighs the privacy cost for your dataset.
AIVORAML_RETAIN_PREDICTION_INPUTS=false

# Local mode rejects non-loopback Host and browser Origin values. These unsafe
# overrides should stay false unless an authenticated hosted mode is added.
AIVORAML_ALLOW_NONLOCAL_HOSTS=false
AIVORAML_ALLOW_NONLOCAL_ORIGINS=false

# Set true only while diagnosing a trusted local development instance.
AIVORAML_ENABLE_DEBUG=false
